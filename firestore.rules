rules_version = '2';
// Reglas de Firestore para FORKY: cada usuario solo ve y cambia sus propios datos
// (users/{su uid}/...). Pégalas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
